# ═══════════════════════════════════════════════════════════════════════════
#  delegate-mock configuration
# ═══════════════════════════════════════════════════════════════════════════
#
#  cp .env.example .env
#
#  Read by the backend (backend/app/config.py); environment variables win over
#  this file. Commented-out lines show the default already in config.py.
#  No secret values here: generate them per install.


# ─── Database ──────────────────────────────────────────────────────────────

# The local Postgres from docker-compose.yml (port 5434). Tests use the same
# server with `_test` appended to the database name.
DATABASE_URL=postgresql+psycopg://mock:mock@localhost:5434/mock


# ─── Identity of the running build ─────────────────────────────────────────

# `local`, `dev` or `prod`. Shown in logs and health.
# APP_ENV=local

# Set by the image build (for example the git SHA). Shown in logs, health and,
# for the frontend build, in the UI footer.
# APP_VERSION=dev


# ─── Public address and browser access ─────────────────────────────────────

# The UI's public address. Anything but localhost counts as public: /docs is
# hidden and the backend refuses to start without RESEND_API_KEY.
# APP_URL=http://localhost:3010

# Comma-separated origins allowed to POST. The public origin must be here, or
# every POST (login included) gets 403.
# CORS_ORIGINS=http://localhost:3010


# ─── Sessions and passwords ────────────────────────────────────────────────

# Session cookie over HTTPS only. Stays true locally: browsers accept it on
# http://localhost. Only tests turn it off.
# SESSION_COOKIE_SECURE=true
# SESSION_IDLE_HOURS=8
# SESSION_MAX_DAYS=30
# PASSWORD_MIN_LENGTH=12


# ─── Secrets ───────────────────────────────────────────────────────────────

# Encrypts the provider keys saved with `just set-org-key`. Generate one per
# install, once, and never change it: keys saved with it cannot be read with
# another. The backend refuses to start if keys are saved and this is empty.
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEYS_ENCRYPTION_KEY=

# Resend, for the test email. Empty = the email is logged at WARNING instead.
# `onboarding@resend.dev` only delivers to the Resend account's own address.
RESEND_API_KEY=
# EMAIL_FROM=Mock <onboarding@resend.dev>


# ─── Files and jobs ────────────────────────────────────────────────────────

# Relative to the repo root locally; absolute on servers (the mounted volume).
# STORAGE_DIR=storage
# MAX_UPLOAD_MB=500

# How long the simulated job after an upload takes. Set it above the API's
# graceful-shutdown timeout to see a deploy leave the file `interrupted`.
# JOB_SECONDS=30

# How often expired sessions and old audit rows are deleted. 0 disables it.
# CLEANUP_INTERVAL_HOURS=24

# The silent phase of the stream test, in seconds.
# STREAM_SILENCE_S=20

# LOG_LEVEL=INFO


# ─── Frontend (read by Next, not by the backend) ───────────────────────────
#
#  Next does not read this file. Set these in the frontend's environment.
#
#  API_INTERNAL_URL  where the Next server reaches the backend, read at run time
#                    (default http://localhost:8010). In containers, e.g.
#                    http://api:8000.
#  APP_VERSION       read at build time: becomes the build ID and the footer's
#                    version.
