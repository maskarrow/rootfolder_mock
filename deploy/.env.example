# /opt/rootfolder/.env on the server: owner deploy, chmod 640, never in git.
# Keep a copy of every value in the password manager.
#
# Used twice by compose: to fill ${...} in compose.yaml, and as the api container's
# environment. A change takes effect with `docker compose up -d`.

# --- The address -------------------------------------------------------------

DOMAIN=rootfolder.app

# --- Postgres ----------------------------------------------------------------

POSTGRES_USER=rootfolder
POSTGRES_DB=rootfolder
# URL-safe, it goes into DATABASE_URL:  openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Files -------------------------------------------------------------------

# Where uploaded PDFs live on the server, owned by uid 10001 (the api image's user).
STORAGE_HOST_DIR=/mnt/storage/pdfs
# Deploys stop if this is not a mounted volume. Empty = no check.
STORAGE_MOUNT=/mnt/storage

# --- The app (backend/app/config.py) -----------------------------------------

APP_ENV=prod
APP_URL=https://rootfolder.app
# The public origin, or every POST, login included, gets 403.
CORS_ORIGINS=https://rootfolder.app

# Encrypts the provider keys saved with set_org_key.py. Generate once, never
# change:  openssl rand -base64 32 | tr '+/' '-_'
API_KEYS_ENCRYPTION_KEY=

# Required: with a public APP_URL the backend refuses to start without it.
RESEND_API_KEY=
EMAIL_FROM=Mock <onboarding@resend.dev>

# Long enough that a deploy in the middle of the job leaves the file `interrupted`.
JOB_SECONDS=120
