# The app on https://${DOMAIN}. Plain HTTP and www redirect to it; any other host
# name (scanners that hit the bare IP) gets nothing.
#
# The nginx image fills in ${DOMAIN} from the environment when the container starts;
# nginx's own variables ($host, $request_id, ...) are left alone. A change here
# takes effect with `docker compose up -d --force-recreate nginx`, after
# `docker compose run --rm --no-deps nginx nginx -t` has said it is valid.

# The request ID nginx generates goes to the app as X-Request-ID, so one request has
# the same ID in this log and in the app's JSON lines.
log_format main_rid '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                    'rt=$request_time rid=$request_id "$http_user_agent"';

# --- Limits --------------------------------------------------------------------
#
# Clients are companies: a whole office often shares one IP. So the API has a
# generous ceiling per IP and a stricter one per session; one user cannot use up the
# office's share, and an unauthenticated flood still meets the per-IP ceiling. An
# empty key is not counted, so requests without a session only meet the IP limit.

map $cookie_mock_session $session_key {
    ""      "";
    default $cookie_mock_session;
}
# Uploads are limited apart from the rest: each can put 500 MB on the disk.
map $request_method $upload_key {
    POST    $binary_remote_addr;
    default "";
}

# An upload without a session cookie is refused at the door, before its body (up
# to 510 MB) crosses to the api. The api would refuse it too, also before reading.
map "$request_method:$cookie_mock_session" $anonymous_upload {
    "POST:" 1;
    default 0;
}

limit_req_zone $binary_remote_addr zone=api_ip:10m rate=100r/s;
limit_req_zone $session_key zone=api_session:10m rate=20r/s;
# Login costs an argon2 hash each time; the app also blocks after 10 failures per
# email or 50 per IP in 15 minutes.
limit_req_zone $binary_remote_addr zone=login:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=stream:10m rate=10r/m;
limit_req_zone $upload_key zone=upload:10m rate=12r/m;
# Open connections per IP: stops one client from holding hundreds of slow ones.
limit_conn_zone $binary_remote_addr zone=conn_ip:10m;
limit_conn_zone $upload_key zone=conn_upload:10m;
# nginx's default for a limited request is 503; 429 says what happened.
limit_req_status 429;
limit_conn_status 429;

# --- Slow clients ----------------------------------------------------------------
#
# A client that sends its headers or body very slowly holds a connection for
# nothing. These are the gaps allowed between two reads or writes, not the length
# of a whole upload or download.
client_header_timeout 10s;
client_body_timeout 30s;
send_timeout 30s;
reset_timedout_connection on;
# (keepalive_timeout is set in the app's server block: the image's nginx.conf
# already sets it at this level, and a second one here is an error.)

server_tokens off;

# Docker's DNS, asked again every 10 s. A deploy recreates api and web with new
# addresses; a name resolved once at startup would keep pointing at the old
# container. It also lets nginx start while api and web are down.
resolver 127.0.0.11 valid=10s ipv6=off;

# --- Unknown host names ----------------------------------------------------------

server {
    listen 80 default_server;
    server_name _;
    # 444: close the connection without an answer.
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    # No certificate is shown to a client that did not ask for our name.
    ssl_reject_handshake on;
}

# --- Port 80 -------------------------------------------------------------------

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# --- www -----------------------------------------------------------------------

server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    return 301 https://${DOMAIN}$request_uri;
}

# --- The app -------------------------------------------------------------------

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    # Tickets would let a stolen ticket key decrypt past sessions.
    ssl_session_tickets off;

    access_log /var/log/nginx/access.log main_rid;
    client_max_body_size 10m;
    limit_conn conn_ip 100;
    keepalive_timeout 30s;

    # Through variables, so the names are resolved per request (see `resolver`).
    set $api api:8000;
    set $web web:3000;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # Overwritten, not appended: whatever X-Forwarded-For the client sent is
    # dropped, and the app sees exactly the address nginx saw.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-ID $request_id;

    # An encoded slash, dot or backslash in the path (%2f, %2e, %5c): the building
    # blocks of path traversal, never part of a real path here. Refused at the server
    # level, before any location or rewrite runs -- left to the rewrite + variable
    # upstream below they make nginx answer 500 instead of refusing cleanly. The
    # `^[^?]*` stops at the query string, so an encoded slash inside a ?q= search is
    # untouched. (A bare `if` with `return` is one of its safe uses.)
    if ($request_uri ~* "^[^?]*%(2[ef]|5c)") {
        return 400;
    }

    # No dotfiles anywhere (.env, .git, ...): nothing here should serve them.
    location ~ /\. {
        return 404;
    }

    # /api/... goes to the backend without the prefix. The UI gets HSTS from Next;
    # API responses get it here.

    # Uploads: up to the app's 500 MB cap plus the multipart overhead, passed on as
    # they arrive instead of first written to nginx's disk. Above 510 MB nginx
    # answers 413 itself; at 500-510 MB the app answers with a readable message.
    # Listing (GET) has the normal limits; uploading (POST) also these: 12 a minute
    # and 4 at the same time per IP.
    location = /api/files {
        if ($anonymous_upload) {
            return 401;
        }
        limit_req zone=api_ip burst=200 nodelay;
        limit_req zone=api_session burst=40 nodelay;
        limit_req zone=upload burst=6 nodelay;
        limit_conn conn_upload 4;
        client_max_body_size 510m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        add_header Strict-Transport-Security "max-age=31536000" always;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api;
    }

    location = /api/auth/login {
        limit_req zone=login burst=10 nodelay;
        # An email and a password: nothing larger is a login.
        client_max_body_size 16k;
        add_header Strict-Transport-Security "max-age=31536000" always;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api;
    }

    # The streamed answer: the backend sends `X-Accel-Buffering: no`, so nginx
    # passes it through as it comes. FastAPI pings every 15 s of silence, well under
    # the read timeout.
    location = /api/stream {
        limit_req zone=stream burst=5 nodelay;
        proxy_read_timeout 300s;
        add_header Strict-Transport-Security "max-age=31536000" always;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api;
    }

    location /api/ {
        limit_req zone=api_ip burst=200 nodelay;
        limit_req zone=api_session burst=40 nodelay;
        add_header Strict-Transport-Security "max-age=31536000" always;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api;
    }

    # The app has no images, so Next's image optimizer at /_next/image is only a way
    # to make the Next server fetch a URL (a small same-origin SSRF, and a 500 when
    # the target is not an image). `unoptimized` in next.config disables the
    # component, not this route, so it is closed here where nginx fronts everything.
    location = /_next/image {
        return 404;
    }

    location / {
        limit_req zone=api_ip burst=200 nodelay;
        proxy_pass http://$web;
    }
}
