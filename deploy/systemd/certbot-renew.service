[Unit]
Description=Renew the Let's Encrypt certificate and reload nginx
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/rootfolder
# Renews only when the certificate is within 30 days of expiring.
ExecStart=/usr/bin/docker compose run --rm certbot renew --quiet
ExecStartPost=/usr/bin/docker compose exec -T nginx nginx -s reload
